# Copy to .env.local and fill in. Used by app/api/quote/route.js (quote requests
# from /pricing) and app/api/contact/route.js (enquiries from /contact).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=hello@aspiremedx.com
SMTP_PASS=your-smtp-or-app-password

# Where quote requests are delivered, and the "from" address (defaults to SMTP_USER)
QUOTE_TO_EMAIL=hello@aspiremedx.com
QUOTE_FROM_EMAIL="AspireMedX Website <hello@aspiremedx.com>"
